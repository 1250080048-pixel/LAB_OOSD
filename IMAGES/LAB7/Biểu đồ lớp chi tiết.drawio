        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nhide empty members\nskinparam classBackgroundColor white\nskinparam classBorderColor black\nskinparam ArrowColor black\n\nclass TuyenDung {\n  maTuyenDung : int\n  viTri : String\n  soLuong : int\n  ngayDang : Date\n  hanNop : Date\n  moTa : String\n  trangThai : String\n  --\n  taoTinTuyenDung() : void\n  capNhatTinTuyenDung() : void\n  dongTinTuyenDung() : void\n}\n\nclass HoSoUngVien {\n  maUngVien : int\n  hoTen : String\n  ngaySinh : Date\n  soDienThoai : String\n  email : String\n  diaChi : String\n  trinhDo : String\n  ketQuaPhongVan : String\n  trangThai : String\n  --\n  tiepNhanHoSo() : void\n  capNhatHoSo() : void\n  danhGiaUngVien() : void\n  ghiNhanKetQua() : void\n}\n\nclass HopDongLaoDong {\n  maHopDong : int\n  loaiHopDong : String\n  ngayKy : Date\n  ngayBatDau : Date\n  ngayHetHan : Date\n  mucLuong : double\n  trangThai : String\n  --\n  lapHopDong() : void\n  capNhatHopDong() : void\n  giaHanHopDong() : void\n  ketThucHopDong() : void\n}\n\nclass NhanVien {\n  maNV : String\n  hoTen : String\n  ngaySinh : Date\n  gioiTinh : String\n  diaChi : String\n  soDienThoai : String\n  email : String\n  ngayVaoLam : Date\n  trangThai : String\n  --\n  themNhanVien() : void\n  capNhatThongTin() : void\n  xemLichLamViec() : void\n  xemPhieuLuong() : void\n}\n\nclass HoSoBaoHiem {\n  maHoSo : int\n  loaiBaoHiem : String\n  maSoBaoHiem : String\n  ngayBatDau : Date\n  ngayKetThuc : Date\n  trangThai : String\n  --\n  themHoSo() : void\n  capNhatHoSo() : void\n  traCuuHoSo() : void\n}\n\nclass QuyetDinhLuong {\n  maQuyetDinhLuong : int\n  mucLuongCu : double\n  mucLuongMoi : double\n  ngayQuyetDinh : Date\n  ngayApDung : Date\n  lyDo : String\n  --\n  lapQuyetDinh() : void\n  capNhatQuyetDinh() : void\n  pheDuyetQuyetDinh() : void\n}\n\nclass QuyetDinhChucVu {\n  maQuyetDinhCV : int\n  chucVuCu : String\n  chucVuMoi : String\n  ngayQuyetDinh : Date\n  ngayApDung : Date\n  lyDo : String\n  --\n  lapQuyetDinh() : void\n  capNhatQuyetDinh() : void\n  pheDuyetQuyetDinh() : void\n}\n\nclass KhenThuongKyLuat {\n  maQuyetDinh : int\n  loaiQuyetDinh : String\n  noiDung : String\n  soTien : double\n  ngayQuyetDinh : Date\n  lyDo : String\n  --\n  lapQuyetDinh() : void\n  capNhatQuyetDinh() : void\n  pheDuyetQuyetDinh() : void\n}\n\nclass LichLamViec {\n  maLich : int\n  ngayLam : Date\n  caLam : String\n  gioBatDau : Time\n  gioKetThuc : Time\n  loaiCa : String\n  --\n  lapLich() : void\n  capNhatLich() : void\n  phanCaNhanVien() : void\n}\n\nclass ChamCong {\n  maChamCong : int\n  ngayChamCong : Date\n  gioVao : Time\n  gioRa : Time\n  soGioLam : double\n  soGioTangCa : double\n  trangThai : String\n  --\n  ghiNhanChamCong() : void\n  capNhatChamCong() : void\n  tinhGioLam() : double\n  tinhGioTangCa() : double\n}\n\nclass BangLuong {\n  maBangLuong : int\n  thang : int\n  nam : int\n  luongCoBan : double\n  tienPhuCap : double\n  tienTangCa : double\n  tienKhauTru : double\n  tongLuong : double\n  ngayLap : Date\n  trangThai : String\n  --\n  tinhLuong() : double\n  lapBangLuong() : void\n  xacNhanBangLuong() : void\n}\n\nclass PhieuThuChi {\n  maPhieu : int\n  loaiPhieu : String\n  noiDung : String\n  soTien : double\n  ngayLap : Date\n  nguoiLap : String\n  --\n  lapPhieu() : void\n  capNhatPhieu() : void\n  inPhieu() : void\n}\n\nTuyenDung \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoUngVien\nHoSoUngVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong : trúng tuyển\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; KhenThuongKyLuat\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; LichLamViec\nLichLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuong\nBangLuong \&quot;1\&quot; -- \&quot;